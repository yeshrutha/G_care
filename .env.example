# Port to run the server on (Render sets this automatically)
PORT=8787

# Node Environment
NODE_ENV=development

# JSON Web Token configurations
JWT_SECRET=gcare-dev-secret-change-in-production
JWT_EXPIRES_IN=7d

# Database Connection string. Leave empty/commented out to use the local file-based JSON DB fallback.
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gcare

# Allowed CORS Origins (comma-separated)
CORS_ORIGIN=http://127.0.0.1:8080,http://localhost:8080,http://localhost:8081
