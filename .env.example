# Port to run the server on (Render sets this automatically)
PORT=8787

# Node Environment
NODE_ENV=development

# JSON Web Token configurations
JWT_SECRET=replace-with-a-private-random-secret-at-least-32-characters
JWT_EXPIRES_IN=7d

# Backend-only PostgreSQL connection; do not place credentials in VITE_ variables.
DATABASE_URL=postgresql://YOUR_USER:YOUR_PASSWORD@127.0.0.1:5432/gcare
# JSON fallback is selected only when DATABASE_URL is absent.
PGSSL=false
PG_POOL_MAX=10
TELEMETRY_HISTORY_INTERVAL_MS=10000
# Real database integration test database (separate from your application database).
# TEST_DATABASE_URL=postgresql://YOUR_USER:YOUR_PASSWORD@127.0.0.1:5432/gcare_test
# Persistent PDF storage; a persistent disk is required on Render.
DATA_DIR=./data
DEMO_AUTH_ENABLED=true

# Allowed CORS Origins (comma-separated)
CORS_ORIGIN=http://127.0.0.1:8080,http://localhost:8080,http://localhost:8081

# Private owner portal; never use VITE_ variables for these values.
OWNER_EMAIL=
OWNER_PASSWORD_HASH=

# Local-only owner portal. Always leave disabled on deployed servers.
OWNER_LOCAL_ENABLED=false
